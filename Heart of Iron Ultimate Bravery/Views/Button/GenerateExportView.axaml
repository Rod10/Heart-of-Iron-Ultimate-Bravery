<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:assets="clr-namespace:Heart_of_Iron_Ultimate_Bravery.Assets.Localization"
             x:Class="Heart_of_Iron_Ultimate_Bravery.Views.Button.GenerateExportView"
             xmlns:vm="using:Heart_of_Iron_Ultimate_Bravery.ViewModels.Button"
             x:DataType="vm:GenerateExportViewModel">
	<Design.DataContext>
		<vm:GenerateExportViewModel />
	</Design.DataContext>
	<Panel>
		<StackPanel HorizontalAlignment="Center" 
		            VerticalAlignment="Center"
		            Spacing="25">
			<Button Command="{Binding OpenShipWindow}"
			        Classes="ButtonMenu"
			        Content="{x:Static assets:Resources.ShipText}" />
			<Button Command="{Binding OpenTankWindow}"
			        Classes="ButtonMenu"
			        Content="{x:Static assets:Resources.TankText}" />
			<Button Command="{Binding OpenPlaneWindow}"
			        Classes="ButtonMenu"
			        Content="{x:Static assets:Resources.PlaneText}" />
			<Button Command="{Binding OpenDivisionWindow}" 
			        Classes="ButtonMenu"
			        Content="{x:Static assets:Resources.DivisionText}" />
			<Button Command="{Binding OpenDoctrinesWindow}" 
			        Classes="ButtonMenu"
			        Content="{x:Static assets:Resources.DoctrineText}" />
			<Button Command="{Binding OpenMainMenuWindow}"
			        Classes="ButtonMenu"
			        Content="{x:Static assets:Resources.BackText}" />
		</StackPanel>
	</Panel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Heart_of_Iron_Ultimate_Bravery.ViewModels.Panel"
             xmlns:models="clr-namespace:Heart_of_Iron_Ultimate_Bravery.Models"
             mc:Ignorable="d" d:DesignWidth="938" d:DesignHeight="684"
             x:Class="Heart_of_Iron_Ultimate_Bravery.Views.Panel.UnitGenerationView"
             x:DataType="vm:UnitGenerationViewModel">

  <Design.DataContext>
      <!-- This only sets the DataContext for the previewer in an IDE,
           to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
      <vm:UnitGenerationViewModel/>
  </Design.DataContext>
    
    <Panel Background="#6D7A67" Width="938" Height="684"> <!-- Red background to see the Canvas -->
            <ItemsControl ItemsSource="{Binding FirstRowBackground}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Background="Blue" /> <!-- Blue to see ItemsPanel -->
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="models:DesignerItem">
                        <Canvas Canvas.Left="{Binding Left}"
                                Canvas.Top="{Binding Top}"
                                Background="Yellow"
                                Width="100"
                                Height="100">
                            <TextBlock Text="{Binding Left}" Foreground="Black"/>
                            <Image Width="{Binding Width}"
                                   Source="{Binding Image}"/>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
    </Panel>
</UserControl>
